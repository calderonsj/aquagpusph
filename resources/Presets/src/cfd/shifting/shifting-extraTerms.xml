<?xml version="1.0" ?>

<!-- deltaSPH.xml
Extra terms needed for delta-plus SPH formulation.
This is a pseudo-ALE formulation.

These terms are built from the consideration of shifting velocity into the equations.

The present implementation is based on the following reference:

Antuono, M., et al. "The δ-ALE-SPH model: An arbitrary Lagrangian-Eulerian framework 
for the δ-SPH model with particle shifting technique." Computers & Fluids 216 (2021).
-->

<sphInput>
    <Variables>
	<Variable name="div_du" type="float*" length="N" />
	<Variable name="div_drho" type="float*" length="N" />
	<Variable name="div_mu" type="vec*" length="N" />
    </Variables>

    <Tools>
	<Tool action="insert" after="Sort" type="set" name="cfd Reinit div_du" in="div_du" value="0.0"/>
	<Tool action="insert" after="Sort" type="set" name="cfd Reinit div_rdho" in="div_drho" value="0.0"/>
	<Tool action="insert" after="Sort" type="set" name="cfd Reinit div_mu" in="div_mu" value="VEC_ZERO"/>

        <Tool action="insert" after="cfd interactions" type="kernel" name="cfd extra fluid ALE continuity" entry_point="extra" path="../../../Scripts/cfd/shifting/shifting-extraTerms.cl"/>		
	<Tool action="insert" after="cfd rates" type="kernel" name="cfd extra ALE rates" entry_point="rates" path="../../../Scripts/cfd/shifting/shifting-extraTerms.cl"/>

        </Tools>
</sphInput>